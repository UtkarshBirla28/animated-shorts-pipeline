 "lines_final_voice": [
  {
   "id": "v3_n01",
   "spk": "N",
   "s": 0.07,
   "rms": -16.2,
   "vs_narr": -0.1,
   "peak": -2.6,
   "text": "His bag is on that train."
  },
  {
   "id": "v3_n02",
   "spk": "N",
   "s": 1.72,
   "rms": -15.9,
   "vs_narr": 0.2,
   "peak": -2.9,
   "text": "He is not."
  },
  {
   "id": "v3_n03",
   "spk": "N",
   "s": 2.78,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.0,
   "text": "All he did was laugh... at a finger."
  },
  {
   "id": "v3_d01",
   "spk": "D",
   "s": 5.5,
   "rms": -17.1,
   "vs_narr": -1.0,
   "peak": -2.6,
   "text": "Signal... green!"
  },
  {
   "id": "v3_t01",
   "spk": "T",
   "s": 7.17,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.6,
   "text": "He's pointing at nothing!"
  },
  {
   "id": "v3_n04",
   "spk": "N",
   "s": 8.81,
   "rms": -16.0,
   "vs_narr": 0.1,
   "peak": -2.6,
   "text": "But that driver has a thousand people behind him."
  },
  {
   "id": "v3_n05",
   "spk": "N",
   "s": 11.54,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.6,
   "text": "So he checks with a finger and a shout."
  },
  {
   "id": "v3_n06",
   "spk": "N",
   "s": 14.12,
   "rms": -16.6,
   "vs_narr": -0.5,
   "peak": -2.6,
   "text": "First stop."
  },
  {
   "id": "v3_n07",
   "spk": "N",
   "s": 15.25,
   "rms": -15.9,
   "vs_narr": 0.2,
   "peak": -2.6,
   "text": "His suitcase tries to get off..."
  },
  {
   "id": "v3_n08",
   "spk": "N",
   "s": 17.45,
   "rms": -15.6,
   "vs_narr": 0.5,
   "peak": -2.6,
   "text": "...and the boy's finger saves it."
  },
  {
   "id": "v3_t02",
   "spk": "T",
   "s": 19.34,
   "rms": -18.6,
   "vs_narr": -2.5,
   "peak": -2.6,
   "text": "Bad suitcase."
  },
  {
   "id": "v3_d02",
   "spk": "D",
   "s": 21.97,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.6,
   "text": "Doors... closed!"
  },
  {
   "id": "v3_t03",
   "spk": "T",
   "s": 24.14,
   "rms": -17.5,
   "vs_narr": -1.4,
   "peak": -2.6,
   "text": "What's a finger gonna do?"
  },
  {
   "id": "v3_n09",
   "spk": "N",
   "s": 25.82,
   "rms": -17.5,
   "vs_narr": -1.4,
   "peak": -2.6,
   "text": "Second stop."
  },
  {
   "id": "v3_t04",
   "spk": "T",
   "s": 27.12,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.6,
   "text": "Stay. Be right back."
  },
  {
   "id": "v3_n10",
   "spk": "N",
   "s": 29.62,
   "rms": -18.1,
   "vs_narr": -2.0,
   "peak": -3.5,
   "text": "It stays."
  },
  {
   "id": "v3_t05",
   "spk": "T",
   "s": 31.7,
   "rms": -18.0,
   "vs_narr": -1.9,
   "peak": -2.6,
   "text": "Vending machine... check!"
  },
  {
   "id": "v3_t06",
   "spk": "T",
   "s": 36.44,
   "rms": -16.4,
   "vs_narr": -0.2,
   "peak": -2.6,
   "text": "This kid gets it!"
  },
  {
   "id": "v3_n11",
   "spk": "N",
   "s": 38.53,
   "rms": -15.6,
   "vs_narr": 0.5,
   "peak": -2.1,
   "text": "You see, his eyes looked right at it. His mind was on his phone."
  },
  {
   "id": "v3_r01",
   "spk": "T",
   "s": 42.47,
   "rms": -21.5,
   "vs_narr": -5.4,
   "peak": -4.6,
   "text": "What's a finger gonna do?"
  },
  {
   "id": "v3_n12",
   "spk": "N",
   "s": 43.88,
   "rms": -15.7,
   "vs_narr": 0.4,
   "peak": -2.6,
   "text": "Japan's railway lab tested it."
  },
  {
   "id": "v3_n13",
   "spk": "N",
   "s": 46.05,
   "rms": -16.6,
   "vs_narr": -0.5,
   "peak": -2.6,
   "text": "For every six mistakes people made just looking... when they pointed and said it out loud: about one."
  },
  {
   "id": "v3_n14",
   "spk": "N",
   "s": 53.52,
   "rms": -16.1,
