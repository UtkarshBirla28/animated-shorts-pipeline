{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/root.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/sandboxes"
  ]
}
